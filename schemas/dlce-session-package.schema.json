{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gazoir/DLCE/assets/schemas/dlce-session-package.schema.json",
  "title": "DLCE Session Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageFormatVersion",
    "exportedAt",
    "sessionCode",
    "sessionName",
    "displayCode",
    "partyLevel",
    "documents",
    "pcs",
    "assets"
  ],
  "properties": {
    "packageFormatVersion": {
      "type": "integer",
      "const": 3,
      "description": "Bump when DLFI must change how it reads packages. v3 adds assets/Landing Page/ session-art variants (Clean, Logo_Burn, Logo_Only, Title_Only); sessionArt points at Logo_Burn when present."
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC export timestamp; DLFI sorts sessions by the latest of these."
    },
    "sessionCode": { "type": "string", "minLength": 1 },
    "sessionName": { "type": "string" },
    "displayCode": { "type": "string", "minLength": 1 },
    "partyLevel": { "type": "integer" },
    "crLabel": { "type": "string" },
    "foundry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatibility": { "type": "string" },
        "dnd5e": { "type": "string" }
      }
    },
    "sessionArt": {
      "type": ["string", "null"],
      "description": "Landing scene image. Prefer landingPage.logoBurn (v3); falls back to Clean or assets/session/."
    },
    "landingPage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Session artwork variants under assets/Landing Page/. logoBurn is the Foundry Landing background.",
      "properties": {
        "clean": {
          "type": ["string", "null"],
          "description": "Raw session art path"
        },
        "logoBurn": {
          "type": ["string", "null"],
          "description": "Logo + title burned onto session art — Landing scene background"
        },
        "logoOnly": {
          "type": ["string", "null"],
          "description": "Full-resolution transparent PNG with logo only"
        },
        "titleOnly": {
          "type": ["string", "null"],
          "description": "Full-resolution transparent PNG with title only"
        }
      }
    },
    "msd": {
      "type": ["string", "null"],
      "description": "Package-relative path to msd/msd.html"
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentEntry" }
    },
    "pcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pcEntry" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge",
        "event",
        "faction",
        "item",
        "landingPage",
        "location",
        "note",
        "npc",
        "pc",
        "secret",
        "tokens",
        "battlemaps",
        "session"
      ],
      "properties": {
        "challenge": { "type": "array", "items": { "type": "string" } },
        "event": { "type": "array", "items": { "type": "string" } },
        "faction": { "type": "array", "items": { "type": "string" } },
        "item": { "type": "array", "items": { "type": "string" } },
        "landingPage": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Clean / Logo_Burn / Logo_Only / Title_Only under assets/Landing Page/"
        },
        "location": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "array", "items": { "type": "string" } },
        "npc": { "type": "array", "items": { "type": "string" } },
        "pc": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Seated PC portraits under assets/pc/"
        },
        "secret": { "type": "array", "items": { "type": "string" } },
        "tokens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Standing/VTT tokens; paths nest under assets/{type}/tokens/"
        },
        "battlemaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Location battle maps under assets/location/battlemaps/"
        },
        "session": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "documentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "file"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "challenge",
            "event",
            "faction",
            "item",
            "location",
            "note",
            "npc",
            "secret"
          ]
        },
        "name": { "type": "string" },
        "file": {
          "type": "string",
          "description": "Package-relative path under documents/"
        },
        "subtype": { "type": "string" },
        "portrait": {
          "type": ["string", "null"],
          "description": "Primary art path under assets/{type}/"
        },
        "token": {
          "type": ["string", "null"],
          "description": "Token path under assets/{type}/tokens/"
        },
        "tokenScale": {
          "type": ["number", "null"],
          "description": "Foundry prototype token scale. 1.1 when token is a VTTTT bake (margin around the circle for Pseudo3d)."
        },
        "tokens": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "NPCs with multiple VTT token art slots: sequentially numbered package paths (e.g. assets/npc/tokens/{id}_1.webp, {id}_2.webp). DLFI sets prototypeToken.randomImg and a texture.src wildcard (`{id}_*.webp`). `token` should still be the first slot."
        },
        "tokenWildcard": {
          "type": ["string", "null"],
          "description": "Optional package-relative glob containing `*` that matches only this NPC's token slots (e.g. assets/npc/tokens/{id}_*.webp). Takes precedence over auto-detection."
        },
        "battlemap": {
          "type": ["string", "null"],
          "description": "Battle map path under assets/location/battlemaps/"
        },
        "locationIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Linked location DLCE ids for placement / item journals."
        },
        "msdOrder": {
          "type": ["integer", "null"],
          "description": "1-based MSD narrative order for locations and combat challenges (interleaved from buildMsdFlow). Null for other document types and non-combat challenges."
        }
      }
    },
    "pcEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "description": "DLCE World Document id for this PC (pet ownership)."
        },
        "name": { "type": "string" },
        "playerName": {
          "type": ["string", "null"],
          "description": "IRL player display name assigned to this PC when known."
        },
        "playerId": {
          "type": ["string", "null"],
          "description": "Stable DLCE player / seat id when known. DLFI stores it on Actor flags.dlfi.playerId and matches Foundry Users by this before falling back to playerName."
        },
        "ddbId": { "type": ["string", "null"] },
        "ddbUrl": { "type": ["string", "null"] },
        "portrait": {
          "type": ["string", "null"],
          "description": "Package path under assets/pc/ when art was copied."
        },
        "token": {
          "type": ["string", "null"],
          "description": "Package path under assets/pc/tokens/ (VTTTT or standing)."
        },
        "tokenScale": {
          "type": ["number", "null"],
          "description": "Foundry prototype token scale when token is a VTTTT bake (typically 1.1)."
        },
        "pets": {
          "type": "array",
          "items": { "$ref": "#/$defs/petEntry" },
          "description": "Living pets owned by this seated PC."
        }
      }
    },
    "petEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "file", "ownerPcId"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "file": {
          "type": "string",
          "description": "Package-relative documents/{id}.json with combat fields."
        },
        "ownerPcId": {
          "type": "string",
          "description": "DLCE PC id matching pcs[].id."
        },
        "portrait": { "type": ["string", "null"] },
        "token": { "type": ["string", "null"] },
        "tokenScale": { "type": ["number", "null"] },
        "tokens": { "type": ["array", "null"], "items": { "type": "string" } },
        "tokenWildcard": { "type": ["string", "null"] }
      }
    }
  }
}
