<section class="dlfi-app">
  <nav class="dlfi-tabs" aria-label="Damned Lucky tabs">
    <button type="button" class="dlfi-tab{{#if isSessions}} is-active{{/if}}" data-action="setTab" data-tab="sessions">Sessions</button>
    <button type="button" class="dlfi-tab{{#if isImport}} is-active{{/if}}" data-action="setTab" data-tab="import">Import</button>
    <button type="button" class="dlfi-tab{{#if isPack}} is-active{{/if}}" data-action="setTab" data-tab="pack">Pack</button>
    <button type="button" class="dlfi-tab dlfi-tab-players" data-action="openPlayers" {{#if busy}}disabled{{/if}}>Players</button>
  </nav>

  {{#if isImport}}
  <div class="dlfi-panel">
    <div class="dlfi-toolbar">
      <button type="button" data-action="refreshInbox" {{#if busy}}disabled{{/if}}>Refresh inbox</button>
      <button type="button" data-action="chooseZip" {{#if busy}}disabled{{/if}}>Choose zip…</button>
    </div>
    {{#if status}}<p class="dlfi-status">{{status}}</p>{{/if}}

    {{#unless sessions.length}}
      <p class="notes">No Session Package zips found. Export from DLCE, drop the zip into the inbox (or Choose zip…), then Refresh. The inbox folder is created automatically if missing.</p>
    {{/unless}}

    <ol class="dlfi-session-list">
      {{#each sessions}}
      <li class="dlfi-session-row{{#if isNew}} is-new{{/if}}">
        <div class="dlfi-session-main">
          {{#if thumbUrl}}
          <img class="dlfi-session-thumb" src="{{thumbUrl}}" alt="" width="64" height="36">
          {{else}}
          <div class="dlfi-session-thumb is-empty" aria-hidden="true" title="No session art in package"></div>
          {{/if}}
          <div class="dlfi-session-meta">
            <strong>{{displayCode}}{{#if isNew}} <span class="dlfi-new-badge" title="Newer than the version in Sessions">New</span>{{/if}}</strong>
            <span>{{sessionName}}</span>
            <span class="notes">Party L{{partyLevel}}{{#if crLabel}} · CR {{crLabel}}{{/if}} · {{latestExportedAtLabel}}</span>
          </div>
          <button type="button" class="dlfi-load" data-action="loadVersion"
            data-session-code="{{sessionCode}}" data-exported-at="{{latestExportedAt}}"
            {{#if ../busy}}disabled{{/if}}>Load</button>
        </div>
        {{#if versions.length}}
        <label class="dlfi-version-label">
          Version
          <select class="dlfi-version-select" data-session-code="{{sessionCode}}">
            {{#each versions}}
            <option value="{{package.manifest.exportedAt}}"
              {{#if @first}}selected{{/if}}>
              {{exportedAtLabel}}
            </option>
            {{/each}}
          </select>
        </label>
        <button type="button" class="dlfi-load-version" data-action="loadVersion"
          data-session-code="{{sessionCode}}"
          data-exported-at="{{versions.0.package.manifest.exportedAt}}"
          {{#if ../busy}}disabled{{/if}}>Load selected version</button>
        {{/if}}
      </li>
      {{/each}}
    </ol>

    <div class="dlfi-paths">
      <div class="dlfi-path-row">
        <div class="dlfi-path-meta">
          <strong>DLCE inbox</strong>
          <span class="notes">Zip packages only · nested as <code>Session Code · Session Name</code> · keeps 3 newest</span>
          <code class="dlfi-path-value">Data/{{inboxPath}}</code>
        </div>
        <button type="button" data-action="pickInbox" {{#if busy}}disabled{{/if}}>Browse…</button>
      </div>
      <div class="dlfi-path-row">
        <div class="dlfi-path-meta">
          <strong>DLFI imports</strong>
          <span class="notes">Imported artwork tree mirrors the Session Package zip layout</span>
          <code class="dlfi-path-value">Data/{{importsPath}}</code>
        </div>
        <button type="button" data-action="pickImports" {{#if busy}}disabled{{/if}}>Browse…</button>
      </div>
    </div>
  </div>
  {{/if}}

  {{#if isSessions}}
  <div class="dlfi-panel">
    <p class="notes">Imported sessions in this world. Activate switches navigation, the Landing scene, soft-seats players, and the live session without re-importing.</p>
    <div class="dlfi-toolbar">
      <button type="button" data-action="refreshSessions" {{#if busy}}disabled{{/if}}>Refresh</button>
      <button type="button" data-action="openPlayers" {{#if busy}}disabled{{/if}}>Players</button>
      <button type="button" class="dlfi-delete-selected" data-action="deleteSelectedSessions" {{#if busy}}disabled{{/if}}>Delete selected</button>
      <label class="dlfi-inline-check">
        <input type="checkbox" class="dlfi-delete-assets" checked>
        Also remove <code>{{importsPath}}/…</code> asset folders
      </label>
      <label class="dlfi-inline-check">
        <input type="checkbox" data-action="toggleAllSessions" {{#if busy}}disabled{{/if}}>
        Select all
      </label>
    </div>
    {{#if status}}<p class="dlfi-status">{{status}}</p>{{/if}}

    {{#unless hasImported}}
      <p class="notes">No imported sessions yet. Use the Import tab to load a Session Package.</p>
    {{else}}
    <div class="dlfi-session-grid">
      {{#each importedSessions}}
      <article class="dlfi-session-tile{{#if isLive}} is-live{{/if}}" title="{{countsTooltip}}">
        <label class="dlfi-session-tile-check">
          <input type="checkbox" class="dlfi-session-check" value="{{sessionCode}}" aria-label="Select {{displayCode}}" {{#if ../busy}}disabled{{/if}}>
        </label>
        {{#if thumbUrl}}
        <img class="dlfi-session-tile-art" src="{{thumbUrl}}" alt="" loading="lazy">
        {{else}}
        <div class="dlfi-session-tile-art is-empty" aria-hidden="true"></div>
        {{/if}}
        <div class="dlfi-session-tile-body">
          <strong>{{displayCode}} · {{sessionName}}{{#if isLive}} <span class="dlfi-live-badge">Live</span>{{/if}}</strong>
          <span class="notes">Imported {{importedAt}}</span>
          <button type="button" data-action="activateSession" data-session-code="{{sessionCode}}"
            {{#if ../busy}}disabled{{/if}}>{{#if isLive}}Re-activate{{else}}Activate{{/if}}</button>
        </div>
      </article>
      {{/each}}
    </div>
    {{/unless}}
  </div>
  {{/if}}

  {{#if isPack}}
  <div class="dlfi-panel">
    <p class="notes">Snapshot the currently live session into a dated Archive compendium.</p>
    <button type="button" data-action="packLive">Pack live session to Archive</button>
  </div>
  {{/if}}
</section>
